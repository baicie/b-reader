{
  "publisher": "baicie",
  "name": "b-reader",
  "displayName": "b-reader",
  "version": "0.0.0",
  "description": "read more book",
  "author": {
    "email": "zl316546@gmail.com",
    "name": "baicie",
    "url": "https://github.com/baicie"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/b-reader"
  },
  "bugs": {
    "url": "https://github.com/baicie/b-reader/issues"
  },
  "keywords": [
    "b-reader",
    "epub",
    "reader"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "icon/ikun.png",
  "qna": "https://github.com/baicie/b-reader/issues",
  "engines": {
    "vscode": "^1.95.0"
  },
  "l10n": "./l10n",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "b-reader-slider",
          "title": "b-reader",
          "icon": "icon/icon.svg"
        }
      ]
    },
    "views": {
      "b-reader-slider": [
        {
          "type": "webview",
          "id": "b-reader-slider",
          "name": "%b-reader.views.menu.title%"
        }
      ]
    },
    "configuration": {
      "title": "%b-reader.views.menu.settings%",
      "type": "object",
      "properties": {
        "b-reader.unzip": {
          "type": "boolean",
          "default": false,
          "description": "%b-reader.views.menu.settings.unzip%"
        },
        "b-reader.biquge": {
          "type": "string",
          "default": "http://www.xbiquzw.com",
          "description": "%b-reader.views.menu.settings.biquge%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle",
    "build": "pnpm vsce package --no-dependencies",
    "bundle": "tsup",
    "dev": "pnpm run code-debug && pnpm cross-env MODE=dev pnpm tsup --watch",
    "lint": "eslint src --ext ts",
    "code-debug": "tsx ../../scripts/run-code.ts",
    "test": "tsx --test test/book-import.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@b-reader/epub": "workspace:^",
    "@b-reader/online": "workspace:^",
    "@b-reader/utils": "workspace:^",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@b-reader/client": "workspace:^",
    "@types/lodash": "^4.17.25",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.9.2",
    "cross-env": "^10.1.0"
  },
  "config": {
    "type": "extension",
    "publish": false
  }
}
